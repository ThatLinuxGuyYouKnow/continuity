# CockroachDB connection string (get via: ccloud cluster connection-string brave-snapper)
DATABASE_URL="postgresql://..."

# AWS Bedrock
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Optional: model IDs
BEDROCK_CHAT_MODEL="anthropic.claude-3-5-sonnet-20241022-v2:0"
BEDROCK_EMBEDDING_MODEL="amazon.titan-embed-text-v2:0"

# Supabase Auth (https://supabase.com/dashboard/project/<ref>/settings/api)
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon key>"
SUPABASE_SERVICE_ROLE_KEY="<service role key>"

# Break-glass QR signing secret (openssl rand -hex 32)
BREAK_GLASS_SECRET=""
